{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-device-data.sh",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "Checking command against device-data guard"
          }
        ]
      }
    ]
  }
}
